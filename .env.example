# Example environment variables (DO NOT commit real secrets).
# Generate a secure ADMIN_API_KEY locally with:
#   npm run generate:admin-key
# Then copy the output into your production/preview env (Vercel, etc.)

ADMIN_API_KEY=replace_with_generated_key
VITE_API_BASE=http://localhost:4000
VITE_ADMIN_API_KEY=replace_with_generated_key_for_frontend
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net
MONGODB_DB=needyneeds
NODE_ENV=production

# Notes:
# - For Vercel, set these under Project → Settings → Environment Variables.
# - If you deploy backend as Vercel Serverless in the same project, you can
#   set `VITE_API_BASE` to your site URL (or leave frontend to call relative `/api`).
MONGODB_URI=mongodb+srv://dorjilhenduptenzin_db_user:slWNG3PGqIy4sOlk@needyneeds.hyds6u8.mongodb.net/?appName=NeedyNeeds
